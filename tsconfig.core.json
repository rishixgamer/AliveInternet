{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/core/**/*.ts", "src/feedback/**/*.ts", "src/intel/**/*.ts", "src/network/**/*.ts", "src/research/**/*.ts", "src/detectors/**/*.ts", "src/rules/**/*.ts", "src/ml/**/*.ts", "src/lib.ts"]
}
